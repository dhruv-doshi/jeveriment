# Required: Vercel AI Gateway API key (not a Vercel account access token).
AI_GATEWAY_API_KEY=

# Required: total USD allowance for the initial preflight + SciFact pilot,
# including retries. Enter 0 for verified free-only requests, or a positive
# amount you authorize. Blank blocks live execution. This is a planned harness
# setting; enforcement will be implemented before any live evaluation calls.
JEV_MAX_COST_USD=

# Vercel's documented TypeSafe-compatible API; retain these defaults.
JEV_API_BASE_URL=https://ai-gateway.vercel.sh/typesafe
JEV_MODEL=typesafe-ai/jev

# Optional Hugging Face read token. Leave blank for public baseline downloads.
HF_TOKEN=

# Local caches, relative to the project root.
HF_HOME=.cache/huggingface
IR_DATASETS_HOME=.cache/ir_datasets
