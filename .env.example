# Required: TypeSafe direct API key from console.typesafe.ai.
TYPESAFE_API_KEY=

# Required: local USD cap for direct TypeSafe calls, including uncertain retries.
JEV_MAX_COST_USD=

# Direct TypeSafe endpoint and pinned Jev version.
JEV_API_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
# Verified published input price in USD per million tokens; recheck before use.
JEV_INPUT_USD_PER_MILLION_TOKENS=0.042

# Optional Hugging Face read token. Leave blank for public baseline downloads.
HF_TOKEN=

# Local caches, relative to the project root.
HF_HOME=.cache/huggingface
IR_DATASETS_HOME=.cache/ir_datasets
